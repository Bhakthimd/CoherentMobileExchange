# =============================================================================
# CoherentMobiles Environment Configuration Template
# Copy this file to .env and configure your secrets. Never commit .env to git!
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=coherentmobiles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Backend (Sessions & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Flask Web Server
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=coherent-mobiles-production-secret-key-change-me

# Default Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@coherent.test
ADMIN_DEFAULT_PASSWORD=Admin@123
VENDOR_DEFAULT_PASSWORD=Vendor@123

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000
